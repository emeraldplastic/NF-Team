# Serverless API (set in Vercel → Project → Settings → Environment Variables)
OPENAI_API_KEY=            # enables AI art, story co-pilot and fusion suggestions via /api/ai/*
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini
PINATA_JWT=                # enables IPFS pinning of minted artwork + ERC-721 metadata

# Client (baked in at build time)
VITE_MULTIPLAYER_URL=      # wss://your-multiplayer-host — leave empty to sync tabs on one device only

# Multiplayer server (server/multiplayer-server.js)
PORT=8787
ALLOWED_ORIGINS=https://nf-team-eosin.vercel.app
